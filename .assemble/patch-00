+# window_pin <on|off|toggle|query>: Hyprland pin shows the window on every workspace.
+# The dispatcher toggles, so on/off only dispatch when the current state differs.
+# Prints "on" or "off". query never changes anything.
+window_pin() {
+  local c addr win cur want do_pin
+  c=$(player_client) || return 1
+  addr=$(jq -r .address <<<"$c"); win="address:$addr"
+  cur=$(jq -r '.pinned // false' <<<"$c")
+  want=${1:-toggle}
+  case $want in
+    query) [[ $cur == true ]] && echo on || echo off; return 0 ;;
+    on|yes|true|1) do_pin=1 ;;
+    off|no|false|0) do_pin=0 ;;
+    *) if [[ $cur == true ]]; then do_pin=0; else do_pin=1; fi ;;
+  esac
+  if [[ $do_pin == 1 && $cur != true ]]; then
+    hypr_dispatch "hl.dsp.window.pin({ window = \"$win\" })" pin "$win"
+  elif [[ $do_pin == 0 && $cur == true ]]; then
+    hypr_dispatch "hl.dsp.window.pin({ window = \"$win\" })" pin "$win"
+  fi
+  [[ $do_pin == 1 ]] && echo on || echo off
+}
